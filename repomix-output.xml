        {"id": 10, "month": "May", "region": "Riyadh", "specialty": "Dermatology", "volume": 3900, "type": "digital", "age_group": "18-34", "gender": "M", "nps": 89}
    ]
}

# --- READ ENDPOINT WITH RESOURCE FILTERS ---
@app.get("/api/v1/consultations")
def get_consultations(
    region: str = Query(None, description="Filter logs by region"),
    type: str = Query(None, description="Filter by 'digital' or 'in-person'")
):
    """Dynamically aggregates dashboard calculations based on parameters."""
    filtered_data = DATABASE["consultations"]
    
    if region:
        filtered_data = [item for item in filtered_data if item["region"].lower() == region.lower()]
    if type:
        filtered_data = [item for item in filtered_data if item["type"].lower() == type.lower()]
        
    # Calculate live pipeline metrics
    total_vol = sum(item["volume"] for item in filtered_data)
    avg_nps = sum(item["nps"] for item in filtered_data) // len(filtered_data) if filtered_data else 0
    digital_count = sum(1 for item in filtered_data if item["type"] == "digital")
    in_person_count = sum(1 for item in filtered_data if item["type"] == "in-person")
    
    return {
        "metadata": {
            "execution_timestamp_ms": int(time.time() * 1000),
            "records_processed": len(filtered_data)
        },
        "kpi_summary": {
            "aggregated_volume": total_vol,
            "running_nps_average": avg_nps,
            "modality_split": {
                "digital_percentage": round((digital_count / len(filtered_data)) * 100, 1) if filtered_data else 0,
                "in_person_percentage": round((in_person_count / len(filtered_data)) * 100, 1) if filtered_data else 0
            }
        },
        "records": filtered_data
    }

# --- CREATE ENDPOINT (DYNAMIC CRUD ADDITION) ---
@app.post("/api/v1/consultations/add")
def log_new_consultation(payload: dict):
    """Inserts a new telemetry item into the runtime state engine."""
    required_keys = ["month", "region", "specialty", "volume", "type", "age_group", "gender", "nps"]
    if not all(key in payload for key in required_keys):
        raise HTTPException(status_code=422, detail="Incomplete structural dataset payload.")
        
    new_id = max(item["id"] for item in DATABASE["consultations"]) + 1 if DATABASE["consultations"] else 1
    
    new_record = {
        "id": new_id,
        "month": str(payload["month"]),
        "region": str(payload["region"]),
        "specialty": str(payload["specialty"]),
        "volume": int(payload["volume"]),
        "type": str(payload["type"]),
        "age_group": str(payload["age_group"]),
        "gender": str(payload["gender"]),
        "nps": int(payload["nps"])
    }
    
    DATABASE["consultations"].append(new_record)
    return {"status": "success", "assigned_index_id": new_id, "inserted_node": new_record}
